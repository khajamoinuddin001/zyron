generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Organization {
  id                  String                @id @default(uuid())
  name                String
  domain              String?               @unique
  status              Status                @default(PENDING)
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt
  logoUrl             String?
  theme               String?
  absentTemplateId    String?
  workingDays         String                @default("[1,2,3,4,5,6]")
  AttendanceRecord    AttendanceRecord[]
  MessageLog          MessageLog[]
  MessageTemplate     MessageTemplate[]
  OrganizationEvent   OrganizationEvent[]
  groups              OrganizationGroup[]
  OrganizationHoliday OrganizationHoliday[]
  OrganizationInvite  OrganizationInvite[]
  members             OrganizationMember[]
  modules             OrganizationModule[]
  roles               OrganizationRole[]
}

model OrganizationHoliday {
  id             String       @id @default(uuid())
  organizationId String
  date           DateTime
  name           String
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, date])
}

model OrganizationRole {
  id             String               @id @default(uuid())
  organizationId String
  name           String
  description    String?
  createdAt      DateTime             @default(now())
  isActive       Boolean              @default(true)
  members        OrganizationMember[]
  organization   Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  allowedModules PlatformModule[]     @relation("OrganizationRoleToPlatformModule")

  @@unique([organizationId, name])
}

model User {
  id                  String               @id @default(uuid())
  email               String               @unique
  passwordHash        String
  firstName           String
  lastName            String?
  isSuperAdmin        Boolean              @default(false)
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  theme               String?
  mobile              String?              @unique
  failedLoginAttempts Int                  @default(0)
  lockedUntil         DateTime?
  memberships         OrganizationMember[]
}

model OrganizationMember {
  id               String                    @id @default(uuid())
  userId           String
  organizationId   String
  role             Role                      @default(STAFF)
  status           Status                    @default(ACTIVE)
  createdAt        DateTime                  @default(now())
  customRoleId     String?
  AttendanceRecord AttendanceRecord[]
  groups           OrganizationGroupMember[]
  customRole       OrganizationRole?         @relation(fields: [customRoleId], references: [id])
  organization     Organization              @relation(fields: [organizationId], references: [id])
  user             User                      @relation(fields: [userId], references: [id])

  @@unique([userId, organizationId])
}

model AuditLog {
  id             String   @id @default(uuid())
  organizationId String?
  userId         String
  action         String
  details        Json?
  createdAt      DateTime @default(now())
}

model PlatformModule {
  id            String               @id @default(uuid())
  key           String               @unique
  name          String
  description   String
  monthlyPrice  Float                @default(0.0)
  createdAt     DateTime             @default(now())
  organizations OrganizationModule[]
  allowedRoles  OrganizationRole[]   @relation("OrganizationRoleToPlatformModule")
}

model OrganizationModule {
  id             String         @id @default(uuid())
  organizationId String
  moduleId       String
  status         Status         @default(ACTIVE)
  installedAt    DateTime       @default(now())
  billingStatus  String         @default("ACTIVE")
  cardExpiry     String?
  cardHolder     String?
  cardLast4      String?
  graceEndsAt    DateTime?
  lastBilledAt   DateTime?
  nextBillAt     DateTime?
  module         PlatformModule @relation(fields: [moduleId], references: [id])
  organization   Organization   @relation(fields: [organizationId], references: [id])

  @@unique([organizationId, moduleId])
}

model AttendanceRecord {
  id             String             @id @default(uuid())
  organizationId String
  memberId       String
  date           DateTime
  status         String
  markedById     String
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  groupId        String?
  group          OrganizationGroup? @relation(fields: [groupId], references: [id], onDelete: Cascade)
  member         OrganizationMember @relation(fields: [memberId], references: [id], onDelete: Cascade)
  organization   Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, memberId, date])
}

model OrganizationGroup {
  id                 String                    @id @default(uuid())
  organizationId     String
  name               String
  type               String
  createdAt          DateTime                  @default(now())
  attendance         AttendanceRecord[]
  organization       Organization              @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  members            OrganizationGroupMember[]
  OrganizationInvite OrganizationInvite[]

  @@unique([organizationId, name])
}

model OrganizationGroupMember {
  id       String             @id @default(uuid())
  groupId  String
  memberId String
  group    OrganizationGroup  @relation(fields: [groupId], references: [id], onDelete: Cascade)
  member   OrganizationMember @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([groupId, memberId])
}

model MessageTemplate {
  id             String       @id @default(uuid())
  organizationId String
  name           String
  content        String
  channel        String       @default("WHATSAPP")
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

model MessageLog {
  id             String       @id @default(uuid())
  organizationId String
  recipient      String
  channel        String
  content        String
  status         String       @default("SENT")
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

model OrganizationEvent {
  id             String       @id @default(uuid())
  organizationId String
  title          String
  description    String?
  startDate      DateTime
  endDate        DateTime
  type           String
  location       String?
  color          String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

model OrganizationInvite {
  id             String             @id @default(uuid())
  organizationId String
  token          String             @unique
  role           Role               @default(STUDENT)
  groupId        String?
  isUsed         Boolean            @default(false)
  createdAt      DateTime           @default(now())
  expiresAt      DateTime?
  group          OrganizationGroup? @relation(fields: [groupId], references: [id])
  organization   Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

enum Status {
  ACTIVE
  SUSPENDED
  PENDING
}

enum Role {
  SUPER_ADMIN
  ORG_ADMIN
  STAFF
  TEACHER
  STUDENT
  PARENT
}
