generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Status {
  ACTIVE
  SUSPENDED
  PENDING
}

enum Role {
  SUPER_ADMIN
  ORG_ADMIN
  STAFF
  TEACHER
  STUDENT
  PARENT
}

model Organization {
  id               String   @id @default(uuid())
  name             String
  domain           String?  @unique
  status           Status   @default(PENDING)
  logoUrl          String?
  theme            String?
  workingDays      String   @default("[1,2,3,4,5,6]") // 0=Sun, 1=Mon...
  absentTemplateId String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  // Relations
  members             OrganizationMember[]
  modules             OrganizationModule[]
  roles               OrganizationRole[]
  groups              OrganizationGroup[]
  AttendanceRecord    AttendanceRecord[]
  MessageTemplate     MessageTemplate[]
  MessageLog          MessageLog[]
  OrganizationHoliday OrganizationHoliday[]
  OrganizationEvent   OrganizationEvent[]
  OrganizationInvite  OrganizationInvite[]
}

model OrganizationHoliday {
  id             String   @id @default(uuid())
  organizationId String
  date           DateTime
  name           String
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, date])
}

model OrganizationRole {
  id             String   @id @default(uuid())
  organizationId String
  name           String // e.g., "Driver", "Dispatcher", "Manager"
  description    String?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())

  // Relations
  organization   Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  members        OrganizationMember[]
  allowedModules PlatformModule[]

  @@unique([organizationId, name])
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  mobile       String?  @unique
  passwordHash String
  firstName    String
  lastName     String?
  theme        String?
  isSuperAdmin Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  
  // Security fields
  failedLoginAttempts Int       @default(0)
  lockedUntil         DateTime?

  // Relations
  memberships OrganizationMember[]
}

model OrganizationMember {
  id             String   @id @default(uuid())
  userId         String
  organizationId String
  role           Role     @default(STAFF)
  customRoleId   String? // points to OrganizationRole
  status         Status   @default(ACTIVE)
  createdAt      DateTime @default(now())

  // Relations
  user             User                      @relation(fields: [userId], references: [id])
  organization     Organization              @relation(fields: [organizationId], references: [id])
  customRole       OrganizationRole?         @relation(fields: [customRoleId], references: [id], onDelete: SetNull)
  groups           OrganizationGroupMember[]
  AttendanceRecord AttendanceRecord[]

  @@unique([userId, organizationId])
}

model AuditLog {
  id             String   @id @default(uuid())
  organizationId String? // Optional for platform-level logs
  userId         String
  action         String
  details        Json?
  createdAt      DateTime @default(now())
}

model PlatformModule {
  id           String   @id @default(uuid())
  key          String   @unique // e.g., 'attendance', 'messaging'
  name         String
  description  String
  monthlyPrice Float    @default(0.0)
  createdAt    DateTime @default(now())

  // Relations
  organizations OrganizationModule[]
  allowedRoles  OrganizationRole[]
}

model OrganizationModule {
  id             String   @id @default(uuid())
  organizationId String
  moduleId       String
  status         Status   @default(ACTIVE)
  installedAt    DateTime @default(now())

  // Billing lifecycle
  billingStatus String    @default("ACTIVE") // "ACTIVE" | "GRACE" | "SUSPENDED" | "UNPAID"
  nextBillAt    DateTime? // When the next charge is due
  graceEndsAt   DateTime? // 3 days after missed payment
  lastBilledAt  DateTime? // Last successful charge

  // Stored payment method (masked — never store raw card data in production)
  cardLast4  String?
  cardExpiry String?
  cardHolder String?

  // Relations
  organization Organization   @relation(fields: [organizationId], references: [id])
  module       PlatformModule @relation(fields: [moduleId], references: [id])

  @@unique([organizationId, moduleId])
}

model AttendanceRecord {
  id             String   @id @default(uuid())
  organizationId String
  memberId       String // References OrganizationMember
  groupId        String? // References OrganizationGroup if taken per group
  date           DateTime // Just the date part
  status         String // "PRESENT", "ABSENT", "LATE"
  markedById     String // References User who marked it
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  member       OrganizationMember @relation(fields: [memberId], references: [id], onDelete: Cascade)
  group        OrganizationGroup? @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@unique([organizationId, memberId, date])
}

model OrganizationGroup {
  id             String   @id @default(uuid())
  organizationId String
  name           String
  type           String // e.g. "CLASS", "DEPARTMENT", "TEAM", "SHIFT"
  createdAt      DateTime @default(now())

  organization       Organization              @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  members            OrganizationGroupMember[]
  attendance         AttendanceRecord[]
  OrganizationInvite OrganizationInvite[]

  @@unique([organizationId, name])
}

model OrganizationGroupMember {
  id       String @id @default(uuid())
  groupId  String
  memberId String

  group  OrganizationGroup  @relation(fields: [groupId], references: [id], onDelete: Cascade)
  member OrganizationMember @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([groupId, memberId])
}

model MessageTemplate {
  id             String   @id @default(uuid())
  organizationId String
  name           String
  content        String
  channel        String   @default("WHATSAPP") // "WHATSAPP", "SMS", "EMAIL"
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

model MessageLog {
  id             String   @id @default(uuid())
  organizationId String
  recipient      String
  channel        String
  content        String
  status         String   @default("SENT") // "SENT", "FAILED"
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

model OrganizationEvent {
  id             String   @id @default(uuid())
  organizationId String
  title          String
  description    String?
  startDate      DateTime
  endDate        DateTime
  type           String // e.g., "HOLIDAY", "EXAM", "MEETING", "GENERAL"
  location       String?
  color          String? // Optional custom color code
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

model OrganizationInvite {
  id             String   @id @default(uuid())
  organizationId String
  token          String   @unique
  role           Role     @default(STUDENT)
  groupId        String?
  isUsed         Boolean  @default(false)
  createdAt      DateTime @default(now())

  organization Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  group        OrganizationGroup? @relation(fields: [groupId], references: [id], onDelete: SetNull)
}
